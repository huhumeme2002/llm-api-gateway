# Copy to .env and fill in real keys. Never commit .env.

# Gateway listener
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_API_KEY=change-me-gateway-key
GATEWAY_ADMIN_API_KEY=change-me-admin-key

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenCode Go — get a key at https://opencode.ai/auth after subscribing to Go
# Docs: https://opencode.ai/docs/go/
OPENCODE_GO_API_KEY=
# OPENCODE_API_KEY is also accepted (same Zen/Go key)

# Optional: one outbound proxy per key (HTTP, HTTPS, or SOCKS5).
# Each credential gets its own http.Client — do not share proxies across keys.
# OPENCODE_GO_KEY_01=
# OPENCODE_GO_PROXY_01=http://user:pass@1.2.3.4:8080
# OPENCODE_GO_KEY_02=
# OPENCODE_GO_PROXY_02=socks5://user:pass@5.6.7.8:1080

# Command Code Provider API — create a key in Studio
# Docs: https://commandcode.ai/docs/provider
# Requires GOAT/Pro/Max/Team/Provider (not the Command Code "Go" plan)
COMMANDCODE_API_KEY=
# COMMANDCODE_KEY_01=
# COMMANDCODE_PROXY_01=http://user:pass@1.2.3.4:8080

# Cache schema bump invalidates all stored entries
CACHE_SCHEMA_VERSION=v1

# Optional: path to YAML config (defaults to ./config.yaml then ./config.example.yaml)
# CONFIG_PATH=./config.yaml

# VPS / container runtime (Go reads these natively)
GOMEMLIMIT=384MiB
GOGC=100
GOMAXPROCS=2
